# Development Dockerfile for backend API server
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy server files
COPY server.js ./

# Expose port
EXPOSE 3001

# Start development server with nodemon for auto-reload
CMD ["npm", "run", "server"]
